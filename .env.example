# Copie en .env (jamais commité). Valeurs de développement uniquement.
POSTGRES_USER=unimoov
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unimoov

# API lancée hors Docker (npm run dev) : base exposée par docker compose sur localhost.
DATABASE_URL=postgres://unimoov:change-me@localhost:5432/unimoov
PORT=3000
API_PORT=3000
LOG_LEVEL=info
# true uniquement derrière un reverse proxy de confiance (Caddy en production).
TRUST_PROXY=false
NODE_ENV=development

# Secret des JWT et des codes : 32 caractères minimum, différent en production.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-secret-a-remplacer-par-32-caracteres-min
# Clé AES-256 des liens d'agenda privés (32 octets en base64), différente en production.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_ENCRYPTION_KEY=ZGV2LWNsZS1hLXJlbXBsYWNlci0zMi1vY3RldHMhISE=
# Tâches planifiées (synchronisation des agendas chaque nuit, propositions le vendredi soir).
JOBS_ENABLED=true
# console : le code d'inscription s'affiche dans les journaux de l'API (refusé en production).
MAIL_PROVIDER=console
# Production : MAIL_PROVIDER=brevo, clé de l'API transactionnelle Brevo (palier gratuit) et
# expéditeur sur le domaine du projet, vérifié chez Brevo (pas une adresse Gmail : refusée ou
# classée en indésirable). Secret : jamais dans le dépôt.
# BREVO_API_KEY=
# MAIL_FROM=ne-pas-repondre@uni-moov.fr
# ban (Base Adresse Nationale via la Géoplateforme) ou fake (hors ligne, quelques adresses d'Annecy).
GEOCODING_PROVIDER=ban
# Itinéraires : estimate (lignes droites, aucun appel externe) ou ors (OpenRouteService,
# clé gratuite sur openrouteservice.org, jamais commitée).
ROUTING_PROVIDER=estimate
ORS_API_KEY=
ROUTING_DAILY_QUOTA=2000
# Paiement : fake (portefeuille simulé, développement seulement) ; prestataire réel en M4b.
PAYMENT_PROVIDER=fake

# Tests d'intégration : base dédiée (nom en _test obligatoire), créée si absente,
# effacée à chaque exécution.
TEST_DATABASE_URL=postgres://unimoov:change-me@localhost:5432/unimoov_test

# Notifications push : log (journal seulement) ou fcm (Firebase Cloud Messaging).
# Avec fcm, chemin du fichier JSON de la clé du compte de service (console Firebase,
# Paramètres du projet, Comptes de service). Secret : jamais dans le dépôt.
# Sous Docker Compose, pose le fichier dans ./secrets/ : il est vu dans /run/secrets/.
PUSH_PROVIDER=log
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json

# Production (docker-compose.prod.yml, docs/deploiement.md) : domaine de l'API, mail pour
# les certificats, sauvegardes (phrase de passe dans secrets/backup-passphrase).
# DOMAIN=api.uni-moov.fr
# ACME_EMAIL=unimoov.support@gmail.com
# BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE=r2:unimoov-backups
